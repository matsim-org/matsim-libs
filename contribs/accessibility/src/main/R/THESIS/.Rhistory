filter((region == "Berlin" & partition == "hour" & scale == "10pct" & temperature == "warm") | (region == "Berlin" & scale == "10pct" & partition == "hour" &
temperature == "cold" &
clickType %in% c("first", "hour_switch") &
sample < 10))
mean_data <- berlin_10pct_3_formats_data %>%
group_by(format, temperature) %>%
summarise(
