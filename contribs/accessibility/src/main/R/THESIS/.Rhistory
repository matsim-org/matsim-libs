library(tidyverse)
library(dplyr)
library(readr)
library(purrr)
library(tidyr)
library(ggplot2)
library(patchwork)
library(stringr)
library(scales)
### DATA SETUP
# Root directory
root <- "/home/brendan/git/simwrapper/benchmark-results/final_tests"
# Find all CSV files recursively
files <- list.files(
root,
pattern = "\\.csv$",
recursive = TRUE,
full.names = TRUE
)
# Function to read and annotate each file
read_benchmark <- function(path) {
# Extract path information
relative_path <- substring(path, nchar(root) + 2)
path_parts <- strsplit(relative_path, "/", fixed = TRUE)[[1]]
temperature <- path_parts[1]
# Backend only exists for warm runs
backend <- if (temperature == "warm") {
path_parts[2]
} else {
NA_character_
}
# Extract metadata from filename
filename <- basename(path)
matches <- str_match(
filename,
"^([^_]+)__(\\d+pct)__(Csv|Parquet|Sqlite)__(none|hour)\\.csv$"
)
if (is.na(matches[1, 1])) {
warning("Could not parse filename: ", filename)
return(NULL)
}
region <- str_to_title(matches[1, 2])
pct <- as.numeric(str_remove(matches[1, 3], "pct"))
format <- matches[1, 4]
partition <- recode(
matches[1, 5],
"none" = "unpartitioned",
"hour" = "hour_partitioned"
)
# Read data and attach metadata
read_csv(path, show_col_types = FALSE) %>%
mutate(
temperature = temperature,
backend = backend,
region = region,
pct = pct,
format = format,
partition = partition,
source_file = filename
)
}
# Load all files into one dataframe
df_all <- map_dfr(files, read_benchmark)
df_all <- df_all %>%
mutate(
partition = recode(
partition,
"hour_partitioned" = "hour",
"unpartitioned" = "none"
),
format = factor(format, levels = c("Csv", "Sqlite", "Parquet")),
backend = factor(backend, levels = c("svn", "s3", "local-host"))
)
format_cols    <- c(Csv = "#ecd113", Sqlite = "#d6336c", Parquet = "#3a8fd0")
backend_cols   <- c("local-host" = "#9756a9", s3 = "#74c43b", svn = "#a6761d")
partition_cols <- c(none = "#999999", hour = "#ff7500")
backend_labels <- c("local-host" = "Local host", s3 = "S3", svn = "SVN server")
scale_fill_format   <- scale_fill_manual(values = format_cols)
scale_colour_format <- scale_colour_manual(values = format_cols)
cold10 <- df_all %>%
filter(temperature == "cold", sample < 10)
# 1. rows per cell and click type (expect 10 everywhere)
cold10 %>%
count(region, scale, format, partition, backend, clickType) %>%
pivot_wider(names_from = clickType, values_from = n)
berlin_1pct_3_formats_data <- df_all %>%
filter((region == "Berlin" & partition == "hour" & scale == "1pct" & temperature == "warm") | (region == "Berlin" & scale == "1pct" & partition == "hour" &
temperature == "cold" &
clickType %in% c("first", "hour_switch") &
sample < 10))
mean_data <- berlin_1pct_3_formats_data %>%
group_by(format, temperature) %>%
summarise(
mean_time = mean(totalTime, na.rm = TRUE),
median_time = median(totalTime, na.rm = TRUE),
.groups = "drop"
)
mean_data
