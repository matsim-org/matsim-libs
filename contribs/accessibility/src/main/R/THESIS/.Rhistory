berlin_bbox <- st_bbox(berlin_sf)
# S-Bahn Ring overlay. The GeoJSON is in WGS84 lon/lat (and carries no CRS
# member), so it must be transformed to the map CRS before plotting;
# fill = NA keeps it as an outline instead of hiding the districts below.
ring_sf <- st_read(
file.path(input_dir, "Berlin shapefiles", "Berlin_sbahn_ring.geojson"),
quiet = TRUE
)
if (is.na(st_crs(ring_sf))) st_crs(ring_sf) <- 4326
ring_sf <- st_transform(ring_sf, 25832)
plot_locations_map <- function(locations,
title = paste0(poi$label, " locations in Berlin"),
label_points = poi$label_points,
show_ring = TRUE) {
p <- ggplot() +
geom_sf(
data = berlin_sf,
fill = "grey95",
color = "grey60",
linewidth = 0.3
)
if (show_ring) {
p <- p +
geom_sf(
data = ring_sf,
fill = NA,
color = "#6a3d9a",
linetype = "dashed",
linewidth = 0.6
)
}
p <- p +
geom_sf(
data = locations,
aes(color = type, shape = type),
size = 2.2,
alpha = 0.85
) +
scale_color_manual(
values = stats::setNames(unname(poi_colors), unname(poi_labels)),
drop = TRUE
) +
scale_shape_manual(
values = stats::setNames(unname(poi_shapes), unname(poi_labels)),
drop = TRUE
) +
coord_sf(
xlim = c(berlin_bbox["xmin"], berlin_bbox["xmax"]),
ylim = c(berlin_bbox["ymin"], berlin_bbox["ymax"])
) +
labs(
title = title,
color = NULL,
shape = NULL
) +
theme_void() +
theme(
legend.position = "bottom",
plot.title = element_text(face = "bold", hjust = 0.5)
)
if (label_points) {
p <- p +
geom_sf_text(
data = locations,
aes(label = name),
size = 3,
vjust = -1,
check_overlap = TRUE,
color = "grey20"
)
}
p
}
# Locations of the selected POI
